{
  "name": "hoprig",
  "version": "0.3.5",
  "description": "Install it on a fresh PC or Linux server and it sets up everything else for coding with Claude Code and OpenCode, managed from one dashboard: sessions that carry on under another provider at a usage limit, coding from anywhere including a phone, and several computers in one place.",
  "keywords": [
    "claude-code",
    "claude",
    "dashboard",
    "setup",
    "dev-environment",
    "multi-account",
    "usage-limit",
    "failover",
    "remote",
    "mobile",
    "web-terminal",
    "self-hosted",
    "tmux",
    "session",
    "multi-machine"
  ],
  "license": "Apache-2.0",
  "author": "Kevin Pareek",
  "homepage": "https://github.com/allswebtech/hoprig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allswebtech/hoprig.git"
  },
  "bugs": {
    "url": "https://github.com/allswebtech/hoprig/issues"
  },
  "type": "module",
  "bin": {
    "hoprig": "bin/hoprig.mjs",
    "hop": "bin/hoprig.mjs"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "test:server": "node tools/test.mjs test/server",
    "eval:assistant": "node test/assistant/eval/run.mjs --profile ${HOPRIG_EVAL_PROFILE:-api} --model ${HOPRIG_EVAL_MODEL:-haiku}"
  },
  "files": [
    "bin",
    "src",
    "web",
    "templates",
    "skills",
    "docs/*.md",
    "test/assistant/eval/*.mjs",
    "test/assistant/eval/baseline.json",
    "test/assistant/fake-dashboard.mjs",
    "test/assistant/fake-work.mjs",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.58.0",
    "qrcode-terminal": "0.12.0",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
