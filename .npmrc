# npm writes no debug log for a command run in this repository (npm test, npm install). npm opens that log when it
# starts, before a script runs, in <its cache>/_logs, and `npm test` sets the cache to the person's own ~/.npm: so a
# run of the test suite left a log in the person's home. This file outranks the person's ~/.npmrc. To get a log for
# one command: npm <command> --logs-max=10 (or --logs-dir <folder>). This file is not part of the published package.
logs-max=0
