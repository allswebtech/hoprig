"node scripts/seed.js && npm start"
"for f in src/*.js; do echo \"$f\"; wc -l \"$f\"; done"
"for f in *.js; do node --check \"$f\" || echo \"bad: $f\"; done"
"cat > .env.example <<'EOF2'\nPORT=3000\nDATABASE_URL=postgres://localhost/app\nEOF2"
"cat <<EOF2 > config.json\n{\"name\": \"app\", \"debug\": true}\nEOF2"
"mkdir -p src/components && touch src/components/Button.jsx"
"git add -A && git commit -m \"Add login form\""
"git switch main && git pull --rebase"
"git stash && git pull && git stash pop"
"git fetch origin && git rebase origin/main"
"source .venv/bin/activate && pip install -r requirements.txt"
"poetry install && poetry run pytest"
"if [ -f requirements.txt ]; then pip install -r requirements.txt; fi"
"if [ ! -d .venv ]; then python3 -m venv .venv; fi"
"[ -f .env ] || cp .env.example .env"
"test -d node_modules || npm install"
"cd src && ls"
"cd .. && pwd"
"node --version && npm --version"
"sleep 2 && curl localhost:3000"
"base64 -d <<< \"aGVsbG8=\""
"while read -r line; do echo \"$line\"; done < urls.txt"
"for i in 1 2 3; do curl -s localhost:3000/api/$i; done"
"for d in */; do (cd \"$d\" && git pull); done"
"case \"$1\" in start) npm start;; stop) pkill node;; esac"
"npm test > test.log 2>&1 || cat test.log"
